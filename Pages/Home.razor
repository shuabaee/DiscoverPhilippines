@page "/"

<div class="screen" id="screen-hero">
    <img src="images/hero.png" alt="Philippines Landscape" class="hero-img">
    
    <div class="hero-content">
        <span class="hero-badge">Pearl of the Orient Seas</span>
        <h1 class="hero-title">Discover the Philippines</h1>
        <p class="hero-intro">
            Uncover 7,641 emerald islands blessed with crystal lagoons, world-class diving spots, rich heritage, and unmatched local hospitality.
        </p>

        <a href="/destinations" class="btn-primary">
            Explore Destinations &rarr;
        </a>

        <!-- Floating Stats Section -->
        <div class="stats-container">
            <div class="stat-item">
                <h3>7,641</h3>
                <p>Islands</p>
            </div>
            <div class="stat-item">
                <h3>#1</h3>
                <p>Beach Spot</p>
            </div>
            <div class="stat-item">
                <h3>100%</h3>
                <p>Warm Smiles</p>
            </div>
        </div>
    </div>
</div>