@page "/"

<div class="relative flex min-h-screen w-full items-center justify-center overflow-hidden bg-ocean pt-20 text-center">

    <img src="images/hero.png"
         alt="Philippines Landscape"
         class="absolute inset-0 h-full w-full object-cover brightness-[0.55] contrast-110" />

    <div class="relative z-10 max-w-[850px] px-6 py-10 text-white">

        <span class="mb-6 inline-block rounded-full border border-white/25 bg-white/10 px-5 py-2 text-sm font-semibold uppercase tracking-wider text-gold backdrop-blur-xl">
            Pearl of the Orient Seas
        </span>

        <h1 class="mb-6 font-display text-5xl font-extrabold leading-[1.1] drop-shadow-2xl md:text-7xl">
            Discover the Philippines
        </h1>

        <p class="mx-auto mb-10 max-w-[700px] text-lg font-light leading-8 text-slate-200 md:text-xl">
            Uncover 7,641 emerald islands blessed with crystal lagoons,
            world-class diving spots, rich heritage, and unmatched local hospitality.
        </p>

        <a href="/destinations"
           class="inline-flex items-center rounded-full bg-gold px-9 py-4 text-base font-bold text-black no-underline shadow-xl shadow-yellow-500/20 transition duration-300 hover:-translate-y-1 hover:bg-gold-hover hover:shadow-2xl md:text-lg">
            Explore Destinations &rarr;
        </a>

        <div class="mt-12 flex justify-center gap-5 border-t border-white/15 pt-8 md:gap-10">

            <div>
                <h3 class="mb-1 font-display text-2xl font-bold text-gold md:text-3xl">
                    7,641
                </h3>
                <p class="text-xs uppercase tracking-wider text-slate-300 md:text-sm">
                    Islands
                </p>
            </div>

            <div>
                <h3 class="mb-1 font-display text-2xl font-bold text-gold md:text-3xl">
                    #1
                </h3>
                <p class="text-xs uppercase tracking-wider text-slate-300 md:text-sm">
                    Beach Spot
                </p>
            </div>

            <div>
                <h3 class="mb-1 font-display text-2xl font-bold text-gold md:text-3xl">
                    100%
                </h3>
                <p class="text-xs uppercase tracking-wider text-slate-300 md:text-sm">
                    Warm Smiles
                </p>
            </div>

        </div>
    </div>
</div>