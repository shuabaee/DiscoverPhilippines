@page "/destinations"

<div class="screen" id="screen-destinations">
    <div class="section-header">
        <span class="section-tag">Curated Getaways</span>
        <h2>Top Destinations</h2>
        <p>Explore our most celebrated tropical islands and natural wonders.</p>
    </div>
    
    <div class="grid-container">
        <!-- Card 1 -->
        <div class="card">
            <div class="card-img-wrapper">
                <span class="card-badge">Top Rated</span>
                <img src="images/palawan.png" class="card-img" alt="El Nido, Palawan">
            </div>
            <div class="card-content">
                <div class="card-location">Palawan</div>
                <h3 class="card-title">El Nido</h3>
                <p class="card-desc">Famous for its towering limestone karst cliffs, hidden emerald lagoons, and untouched marine sanctuaries.</p>
            </div>
        </div>

        <!-- Card 2 -->
        <div class="card">
            <div class="card-img-wrapper">
                <span class="card-badge">Popular</span>
                <img src="images/boracay.png" class="card-img" alt="Boracay Island">
            </div>
            <div class="card-content">
                <div class="card-location">Aklan</div>
                <h3 class="card-title">Boracay Island</h3>
                <p class="card-desc">World-famous four-mile stretch of powdery white sand, vibrant sunsets, and energetic island nightlife.</p>
            </div>
        </div>

        <!-- Card 3 -->
        <div class="card">
            <div class="card-img-wrapper">
                <span class="card-badge">Must Visit</span>
                <img src="images/bohol.png" class="card-img" alt="Chocolate Hills, Bohol">
            </div>
            <div class="card-content">
                <div class="card-location">Bohol</div>
                <h3 class="card-title">Chocolate Hills</h3>
                <p class="card-desc">Marvel at over 1,200 unique cone-shaped geological formations that turn chocolate brown in dry season.</p>
            </div>
        </div>
    </div>

    <div class="next-action-bar">
        <a href="/culture" class="btn-primary">
            Explore Culture & Food &rarr;
        </a>
    </div>
</div>