@page "/destinations"

<div class="relative min-h-screen w-full overflow-hidden bg-ocean px-[8%] pb-24 pt-28">


    <!-- Page Background -->
    <div class="absolute inset-0 z-0">

        <img src="images/ph.jpg"
             alt="Philippines Background"
             class="h-full w-full object-cover object-center" />

        <!-- Dark overlay so the background blends with the page -->
        <div class="absolute inset-0 bg-gradient-to-b from-ocean/80 via-ocean/75 to-ocean/95"></div>

    </div>


    <!-- HEADER -->
    <div class="relative z-10 mb-10 text-center">

        <span class="mb-2 block text-sm font-bold uppercase tracking-[2px] text-gold">
            Curated Getaways
        </span>

        <h2 class="mb-3 font-display text-4xl font-bold text-white md:text-5xl">
            Top Destinations
        </h2>

        <p class="text-base text-slate-300 md:text-lg">
            Explore our most celebrated tropical islands and natural wonders.
        </p>

    </div>


    <!-- SEARCH AND FILTER -->
    <div class="relative z-10 mx-auto mb-10 flex max-w-3xl flex-col gap-4 md:flex-row">

        <!-- Search -->
        <input type="text"
               @bind="searchText"
               @bind:event="oninput"
               placeholder="Search destinations..."
               class="w-full rounded-xl border border-slate-300 bg-white px-5 py-3 text-slate-800 outline-none transition focus:border-gold focus:ring-2 focus:ring-gold/30" />


        <!-- Custom Select -->
        <div class="relative w-full md:w-[250px]">

            <select @bind="selectedLocation"
                    class="w-full appearance-none whitespace-nowrap rounded-xl border border-slate-300 bg-white py-3 pl-5 pr-14 text-slate-800 outline-none transition focus:border-gold focus:ring-2 focus:ring-gold/30">

                <option value="All">All Locations</option>
                <option value="Palawan">Palawan</option>
                <option value="Aklan">Aklan</option>
                <option value="Bohol">Bohol</option>

            </select>

            <!-- Custom Arrow -->
            <div class="pointer-events-none absolute inset-y-0 right-4 flex items-center">

                <svg class="h-4 w-4 text-slate-700"
                     xmlns="http://www.w3.org/2000/svg"
                     fill="none"
                     viewBox="0 0 24 24"
                     stroke="currentColor"
                     stroke-width="2.5">

                    <path stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M6 9l6 6 6-6" />

                </svg>

            </div>

        </div>

    </div>


    <!-- DESTINATION CARDS -->
    <div class="relative z-10 grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">

        @foreach (var destination in FilteredDestinations)
        {
            <div @onclick="() => OpenDestination(destination)"
                 class="group cursor-pointer overflow-hidden rounded-3xl bg-white shadow-xl transition duration-300 hover:-translate-y-2 hover:shadow-2xl">

                <!-- Image -->
                <div class="relative h-[260px] overflow-hidden">

                    <span class="absolute left-4 top-4 z-10 rounded-full bg-ocean/80 px-4 py-2 text-xs font-bold uppercase tracking-wide text-white backdrop-blur-lg">
                        @destination.Badge
                    </span>

                    <img src="@destination.Image"
                         alt="@destination.Name"
                         class="h-full w-full object-cover transition duration-500 group-hover:scale-110" />

                </div>


                <!-- Card Content -->
                <div class="p-7">

                    <div class="mb-1 text-sm font-bold text-gold">
                        @destination.Location
                    </div>

                    <h3 class="mb-3 font-display text-2xl font-bold text-ocean">
                        @destination.Name
                    </h3>

                    <p class="mb-5 text-sm leading-7 text-slate-500">
                        @destination.Description
                    </p>

                    <button @onclick="() => OpenDestination(destination)"
                            @onclick:stopPropagation="true"
                            class="w-full rounded-full bg-ocean px-6 py-3 font-semibold text-white transition duration-300 hover:bg-gold hover:text-black">
                        View Details
                    </button>

                </div>

            </div>
        }

    </div>


    <!-- NO RESULTS -->
    @if (!FilteredDestinations.Any())
    {
        <div class="relative z-10 mt-10 text-center">

            <p class="text-lg text-white">
                No destinations found.
            </p>

        </div>
    }

</div>


<!-- DESTINATION DETAILS MODAL -->
@if (selectedDestination != null)
{
    <div class="fixed inset-0 z-[100] flex items-center justify-center bg-black/70 p-4 backdrop-blur-sm"
         @onclick="CloseDestination">

        <div class="relative max-h-[85vh] w-full max-w-2xl overflow-y-auto rounded-3xl bg-white shadow-2xl"
             @onclick:stopPropagation="true">


            <!-- Modal Image -->
            <div class="relative h-[280px] overflow-hidden rounded-t-3xl">

                <img src="@selectedDestination.Image"
                     alt="@selectedDestination.Name"
                     class="h-full w-full object-cover" />

                <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent"></div>


                <!-- Close Button -->
                <button @onclick="CloseDestination"
                        class="absolute right-5 top-5 flex h-10 w-10 items-center justify-center rounded-full bg-black/50 text-xl text-white transition hover:bg-black">
                    ✕
                </button>


                <!-- Modal Title -->
                <div class="absolute bottom-5 left-6 text-white">

                    <span class="mb-2 inline-block rounded-full bg-gold px-3 py-1 text-xs font-bold uppercase text-black">
                        @selectedDestination.Badge
                    </span>

                    <h2 class="font-display text-3xl font-bold">
                        @selectedDestination.Name
                    </h2>

                    <p class="text-sm text-slate-200">
                        📍 @selectedDestination.Location
                    </p>

                </div>

            </div>


            <!-- Modal Content -->
            <div class="p-7">

                <p class="mb-6 leading-7 text-slate-600">
                    @selectedDestination.FullDescription
                </p>


                <!-- Details -->
                <div class="grid gap-4 sm:grid-cols-2">

                    <div class="rounded-2xl bg-slate-100 p-4">

                        <p class="mb-1 text-xs font-bold uppercase text-gold">
                            Best Time to Visit
                        </p>

                        <p class="font-semibold text-ocean">
                            @selectedDestination.BestTime
                        </p>

                    </div>


                    <div class="rounded-2xl bg-slate-100 p-4">

                        <p class="mb-1 text-xs font-bold uppercase text-gold">
                            Recommended Stay
                        </p>

                        <p class="font-semibold text-ocean">
                            @selectedDestination.RecommendedStay
                        </p>

                    </div>

                </div>


                <!-- Activities -->
                <div class="mt-6">

                    <h3 class="mb-3 font-display text-xl font-bold text-ocean">
                        Popular Activities
                    </h3>

                    <div class="flex flex-wrap gap-2">

                        @foreach (var activity in selectedDestination.Activities)
                        {
                            <span class="rounded-full border border-slate-200 bg-slate-50 px-4 py-2 text-sm text-slate-700">
                                @activity
                            </span>
                        }

                    </div>

                </div>


                <button @onclick="CloseDestination"
                        class="mt-8 w-full rounded-full bg-gold px-6 py-3 font-bold text-black transition hover:bg-gold-hover">
                    Close
                </button>

            </div>

        </div>

    </div>
}


@code {

    private string searchText = "";
    private string selectedLocation = "All";

    private Destination? selectedDestination;


    private List<Destination> destinations = new()
    {
        new Destination(
            "El Nido",
            "Palawan",
            "Top Rated",
            "images/palawan.png",

            "Famous for its towering limestone karst cliffs, hidden emerald lagoons, and untouched marine sanctuaries.",

            "El Nido is one of the Philippines' most famous island destinations. It is known for dramatic limestone cliffs, turquoise lagoons, white-sand beaches, and rich marine life. Visitors can explore nearby islands through island-hopping tours and enjoy snorkeling, kayaking, swimming, and diving.",

            "November to May",

            "3 to 5 Days",

            new List<string>
            {
                "🏝 Island Hopping",
                "🤿 Snorkeling",
                "🚣 Kayaking",
                "🌊 Diving"
            }
        ),

        new Destination(
            "Boracay Island",
            "Aklan",
            "Popular",
            "images/boracay.png",

            "World-famous four-mile stretch of powdery white sand, vibrant sunsets, and energetic island nightlife.",

            "Boracay is famous for its powdery white sand and crystal-clear waters. White Beach is the center of the island's activity, offering water sports, restaurants, shopping, sunset views, and nightlife. Visitors can also explore quieter beaches and nearby islands.",

            "November to May",

            "3 to 4 Days",

            new List<string>
            {
                "🏊 Swimming",
                "⛵ Sunset Sailing",
                "🏄 Water Sports",
                "🏝 Island Hopping"
            }
        ),

        new Destination(
            "Chocolate Hills",
            "Bohol",
            "Must Visit",
            "images/bohol.png",

            "Marvel at over 1,200 unique cone-shaped geological formations that turn chocolate brown in dry season.",

            "The Chocolate Hills are one of Bohol's most recognizable natural attractions. More than a thousand cone-shaped hills cover the landscape. During the dry season, the grass turns brown, giving the hills their famous chocolate-like appearance.",

            "December to May",

            "2 to 3 Days",

            new List<string>
            {
                "📸 Photography",
                "🥾 Sightseeing",
                "🚲 Countryside Tour",
                "🐒 Tarsier Viewing"
            }
        )
    };


    private IEnumerable<Destination> FilteredDestinations =>
        destinations.Where(destination =>
            (string.IsNullOrWhiteSpace(searchText) ||
             destination.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
             destination.Location.Contains(searchText, StringComparison.OrdinalIgnoreCase))
            &&
            (selectedLocation == "All" ||
             destination.Location == selectedLocation)
        );


    private void OpenDestination(Destination destination)
    {
        selectedDestination = destination;
    }


    private void CloseDestination()
    {
        selectedDestination = null;
    }


    private record Destination(
        string Name,
        string Location,
        string Badge,
        string Image,
        string Description,
        string FullDescription,
        string BestTime,
        string RecommendedStay,
        List<string> Activities
    );
}