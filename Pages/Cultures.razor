@page "/culture"

<div class="flex min-h-screen w-full flex-col bg-ocean pt-20 text-white lg:flex-row">

    <!-- CULTURE IMAGE -->
    <div class="relative min-h-[350px] flex-1 lg:min-h-screen lg:flex-[1.1]">

        <img src="images/culture.png"
             alt="Filipino Culture and Festival"
             class="absolute inset-0 h-full w-full object-cover" />

        <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-ocean lg:hidden"></div>
        <div class="absolute inset-0 hidden bg-gradient-to-r from-transparent via-transparent to-ocean lg:block"></div>

    </div>

    <!-- CULTURE CONTENT -->
    <div class="flex flex-1 flex-col justify-center px-[7%] py-16 lg:py-20">

        <span class="mb-2 block text-sm font-bold uppercase tracking-[2px] text-gold">
            Heritage &amp; Hospitality
        </span>

        <h2 class="mb-6 font-display text-4xl font-bold leading-[1.1] text-gold md:text-5xl lg:text-6xl">
            Experience the Heart of the Islands
        </h2>

        <p class="mb-6 text-base leading-8 text-slate-400 md:text-lg">
            Beyond the breathtaking landscapes lie the warm, festive hearts
            of the Filipino people. Immerse yourself in colorful grand street
            festivals, rhythmic music, and timeless traditions.
        </p>

        <p class="mb-4 text-sm text-slate-500">
            Click an item below to learn more.
        </p>

        <!-- CLICKABLE CULTURE ITEMS -->
        <div class="mb-10 flex flex-wrap gap-4">

            <button @onclick="() => OpenCulture(cultureItems[0])"
                    class="flex items-center rounded-full border border-white/10 bg-white/5 px-5 py-3 text-sm font-semibold text-slate-200 transition duration-300 hover:-translate-y-1 hover:border-gold hover:bg-gold hover:text-black">
                Savory Adobo &amp; Sinigang
            </button>

            <button @onclick="() => OpenCulture(cultureItems[1])"
                    class="flex items-center rounded-full border border-white/10 bg-white/5 px-5 py-3 text-sm font-semibold text-slate-200 transition duration-300 hover:-translate-y-1 hover:border-gold hover:bg-gold hover:text-black">
                Sinulog &amp; Ati-Atihan
            </button>

            <button @onclick="() => OpenCulture(cultureItems[2])"
                    class="flex items-center rounded-full border border-white/10 bg-white/5 px-5 py-3 text-sm font-semibold text-slate-200 transition duration-300 hover:-translate-y-1 hover:border-gold hover:bg-gold hover:text-black">
                Sweet Mangoes &amp; Halo-Halo
            </button>

        </div>

        <div>
            <a href="/"
               class="inline-flex items-center rounded-full border-2 border-gold px-8 py-3 font-bold text-gold no-underline transition duration-300 hover:-translate-y-1 hover:bg-gold hover:text-black hover:shadow-xl">
                &larr; Back to Home
            </a>
        </div>

    </div>

</div>


<!-- CULTURE MODAL -->
@if (selectedCulture != null)
{
    <div class="fixed inset-0 z-[100] flex items-center justify-center bg-black/70 p-4 backdrop-blur-sm"
         @onclick="CloseCulture">

        <div class="relative w-full max-w-2xl overflow-hidden rounded-3xl bg-white shadow-2xl"
             @onclick:stopPropagation="true">

            <!-- Modal Image -->
            <div class="relative h-[260px] w-full">
                <img src="@selectedCulture.Image"
                     alt="@selectedCulture.Title"
                     class="h-full w-full object-cover" />

                <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent"></div>

                <button @onclick="CloseCulture"
                        class="absolute right-5 top-5 flex h-10 w-10 items-center justify-center rounded-full bg-black/50 text-xl text-white transition hover:bg-black">
                    ✕
                </button>

                <div class="absolute bottom-5 left-6 text-white">
                    <span class="mb-2 block text-sm font-bold uppercase tracking-[2px] text-gold">
                        @selectedCulture.Category
                    </span>

                    <h2 class="pr-8 font-display text-3xl font-bold">
                        @selectedCulture.Title
                    </h2>
                </div>
            </div>

            <!-- Modal Body -->
            <div class="p-8">

                <p class="leading-8 text-slate-600">
                    @selectedCulture.Description
                </p>

                <div class="mt-6 rounded-2xl bg-slate-100 p-5">
                    <p class="mb-1 text-xs font-bold uppercase tracking-wider text-gold">
                        Did You Know?
                    </p>

                    <p class="text-sm leading-6 text-slate-600">
                        @selectedCulture.Fact
                    </p>
                </div>

                <button @onclick="CloseCulture"
                        class="mt-7 w-full rounded-full bg-gold px-6 py-3 font-bold text-black transition hover:bg-gold-hover">
                    Close
                </button>

            </div>

        </div>

    </div>
}

@code {

    private CultureItem? selectedCulture;

    private List<CultureItem> cultureItems = new()
    {
        new CultureItem(
            "Filipino Cuisine",
            "Savory Adobo & Sinigang",
            "images/adobo.jpg",
            "Adobo and Sinigang are two of the Philippines' most recognizable dishes. Adobo is typically prepared by slowly cooking meat in vinegar, soy sauce, garlic, and spices. Sinigang is a comforting sour soup traditionally flavored with tamarind and served with meat, seafood, and vegetables.",
            "Recipes differ from one region and family to another, making Filipino cuisine especially diverse."
        ),

        new CultureItem(
            "Festivals",
            "Sinulog & Ati-Atihan",
            "images/sinulog.jpg",
            "Sinulog and Ati-Atihan are among the Philippines' most colorful and energetic festivals. Sinulog is celebrated in Cebu and is known for its grand street dances and devotion to the Santo Niño. Ati-Atihan is celebrated in Kalibo, Aklan and features lively dancing, music, costumes, and community celebrations.",
            "Both festivals attract large crowds and showcase the country's combination of history, faith, music, dance, and celebration."
        ),

        new CultureItem(
            "Filipino Favorites",
            "Sweet Mangoes & Halo-Halo",
            "images/halohalo.jpg",
            "Philippine mangoes are famous for their sweetness and rich flavor, particularly mangoes grown in regions such as Guimaras. Halo-Halo is a popular Filipino dessert made with crushed ice, evaporated milk, fruits, sweetened beans, jellies, and other colorful ingredients.",
            "The name Halo-Halo means 'mix-mix' because the ingredients are mixed together before eating."
        )
    };

    private void OpenCulture(CultureItem culture)
    {
        selectedCulture = culture;
    }

    private void CloseCulture()
    {
        selectedCulture = null;
    }

    private record CultureItem(
        string Category,
        string Title,
        string Image,
        string Description,
        string Fact
    );
}