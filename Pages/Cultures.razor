@page "/culture"

<div class="screen" id="screen-culture">
    <div class="culture-image-container">
        <img src="images/culture.png" class="culture-img" alt="Filipino Culture & Festival">
        <div class="culture-overlay"></div>
    </div>
    
    <div class="culture-text">
        <span class="section-tag">Heritage & Hospitality</span>
        <h2>Experience the Heart of the Islands</h2>
        <p>
            Beyond the breathtaking landscapes lie the warm, festive hearts of the Filipino people. Immerse yourself in colorful grand street festivals, rhythmic music, and timeless traditions.
        </p>

        <!-- Feature Tags -->
        <div class="culture-highlights">
            <span class="highlight-pill">🍲 Savory Adobo & Sinigang</span>
            <span class="highlight-pill">🎭 Sinulog & Ati-Atihan</span>
            <span class="highlight-pill">🥭 Sweet Mangoes & Halo-Halo</span>
        </div>

        <div>
            <a href="/" class="btn-outline">
                &larr; Back to Home
            </a>
        </div>
    </div>
</div>